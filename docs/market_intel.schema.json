{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "market_intel_latest.json",
  "description": "Aggregates the heatmap hands to the proposal agent. Never contains job ids, titles, descriptions or URLs.",
  "type": "object",
  "required": ["schema_version", "generated_at", "data_as_of", "window_days", "scoring_version", "bands", "demand", "watch_suggestions", "funnel_summary"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "description": "ISO-8601 UTC"},
    "data_as_of": {"type": "string", "description": "Last successful fetch, ISO-8601 UTC, or 'never'"},
    "window_days": {"type": "integer", "minimum": 1},
    "scoring_version": {"type": "string"},
    "bands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["workflow", "client_segment", "experience", "budget_type", "level", "n", "p25", "p50", "p75"],
        "properties": {
          "workflow": {"type": "string", "description": "Workflow label or 'all'"},
          "client_segment": {"type": "string", "enum": ["champion", "active", "new", "risky", "all"]},
          "experience": {"type": "string", "enum": ["entry", "intermediate", "expert", "unknown", "all"]},
          "budget_type": {"type": "string", "enum": ["HOURLY", "FIXED"]},
          "level": {"type": "string", "enum": ["cell", "workflow", "budget_type"]},
          "n": {"type": "integer", "minimum": 1},
          "p25": {"type": "number"},
          "p50": {"type": "number"},
          "p75": {"type": "number"}
        }
      }
    },
    "demand": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["axis", "label", "jobs", "share"],
        "properties": {
          "axis": {"type": "string", "enum": ["industry", "workflow", "stack", "platform"]},
          "label": {"type": "string"},
          "jobs": {"type": "integer"},
          "share": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "watch_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["expression", "jobs_7d", "median_applicants"],
        "properties": {
          "expression": {"type": "string"},
          "axis": {"type": "string"},
          "jobs_7d": {"type": "integer"},
          "median_applicants": {"type": "number"}
        }
      }
    },
    "funnel_summary": {
      "type": "object",
      "required": ["days", "stages", "win_rate_shrunk", "insufficient"],
      "properties": {
        "days": {"type": "integer"},
        "stages": {"type": "object", "additionalProperties": {"type": "integer"}},
        "win_rate_shrunk": {"type": "number"},
        "win_rate_raw": {"type": ["number", "null"]},
        "insufficient": {"type": "boolean"},
        "cost_per_hire_usd": {"type": ["number", "null"]},
        "median_winning_bid": {"type": ["number", "null"]}
      }
    }
  }
}
