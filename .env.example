# OAuth2 credentials from your registered Upwork app
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=

# Redirect URI — must match exactly what you set in your Upwork app settings
# For localhost:  UPWORK_REDIRECT_URI=http://localhost:8080/callback
# For custom scheme (e.g. upwork-analytics): paste the code manually when prompted
UPWORK_REDIRECT_URI=http://localhost:8080/callback

# Optional: paste an access token directly to skip the auth flow
UPWORK_ACCESS_TOKEN=

# Your local timezone for shift recommendations (e.g. Asia/Kolkata, Asia/Dubai, America/New_York)
TIMEZONE=Asia/Kolkata

# ── Sync & retention (Phase 1) ─────────────────────────────────────────────
# Watches: UPWORK_WATCHES_FILE, else <UPWORK_AGENT_DIR>/watches.txt, else watch_terms.txt
UPWORK_AGENT_DIR=../upwork-proposal-agent
UPWORK_WATCHES_FILE=
UPWORK_SYNC_SINCE_DAYS=2
UPWORK_SYNC_LIMIT=300
# Upwork's terms: fetched data may not be stored beyond 24 hours. Text fields
# listed here are blanked after this many hours; numbers, tags and derived rows stay.
UPWORK_PURGE_TEXT_HOURS=24
UPWORK_PURGE_FIELDS=title,description
UPWORK_STALE_AFTER_HOURS=24
UPWORK_EXPORTS_DIR=exports

# ── Funnel economics (Phase 2) ─────────────────────────────────────────────
UPWORK_CONNECT_PRICE_USD=0.15
UPWORK_DEFAULT_CONNECTS=12
UPWORK_OUTCOMES_DIR=data/outcomes

# ── Scoring (Phase 3) ──────────────────────────────────────────────────────
# Constants live in scoring.toml; point at a copy to experiment without editing it.
UPWORK_SCORING_FILE=
# One term per line; the personal score's `fit` component measures overlap with it.
UPWORK_PORTFOLIO_TAGS=

# ── Phase 4 ────────────────────────────────────────────────────────────────
# Industry tagging of untagged jobs via `claude -p` (Claude Max) during sync.
UPWORK_LLM_TAGGING=1
UPWORK_LLM_TAG_CAP=50
UPWORK_LLM_MODEL=
# Winnable heatmap: a posting counts when it had at most this many applicants at first sight.
UPWORK_WINNABLE_MAX_APPLICANTS=10
# Weekly digest delivery (optional). Plain Telegram Bot API call, no agent code involved.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Detail-stage snapshots (+2h/+24h/+72h via marketplaceJobPosting) per sync run; one API call each.
UPWORK_SNAPSHOT_DETAIL_CAP=300
